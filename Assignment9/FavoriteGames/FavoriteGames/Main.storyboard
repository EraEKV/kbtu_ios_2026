<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="NAV">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Navigation Controller-->
        <scene sceneID="NAV-SCENE">
            <objects>
                <navigationController id="NAV" sceneMemberID="viewController">
                    <navigationBar key="navigationBar" contentMode="scaleToFill" largeTitles="YES" id="NAV-BAR">
                        <rect key="frame" x="0.0" y="59" width="393" height="96"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="VC" kind="relationship" relationship="rootViewController" id="NAV-ROOT"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="NAV-FR" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-700" y="375"/>
        </scene>
        <!--Favorite Games-->
        <scene sceneID="VC-SCENE">
            <objects>
                <viewController id="VC" customClass="GamesViewController" customModule="FavoriteGames" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="V">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" dataMode="prototypes" style="plain" separatorStyle="default" rowHeight="-1" estimatedRowHeight="114" sectionHeaderHeight="-1" estimatedSectionHeaderHeight="-1" sectionFooterHeight="-1" estimatedSectionFooterHeight="-1" translatesAutoresizingMaskIntoConstraints="NO" id="TBL" userLabel="Table View">
                                <rect key="frame" x="0.0" y="155" width="393" height="663"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <prototypes>
                                    <tableViewCell clipsSubviews="YES" contentMode="scaleToFill" preservesSuperviewLayoutMargins="YES" selectionStyle="none" indentationWidth="10" reuseIdentifier="GameCell" id="CELL" customClass="GameCell" customModule="FavoriteGames" customModuleProvider="target">
                                        <rect key="frame" x="0.0" y="50" width="393" height="114"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" preservesSuperviewLayoutMargins="YES" insetsLayoutMarginsFromSafeArea="NO" tableViewCell="CELL" id="CV">
                                            <rect key="frame" x="0.0" y="0.0" width="393" height="114"/>
                                            <autoresizingMask key="autoresizingMask"/>
                                            <subviews>
                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="rdr2" translatesAutoresizingMaskIntoConstraints="NO" id="COVER" userLabel="Cover Image View">
                                                    <rect key="frame" x="16" y="12" width="60" height="90"/>
                                                    <constraints>
                                                        <constraint firstAttribute="width" constant="60" id="C-COVER-W"/>
                                                        <constraint firstAttribute="height" constant="90" id="C-COVER-H"/>
                                                    </constraints>
                                                    <userDefinedRuntimeAttributes>
                                                        <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                                            <integer key="value" value="8"/>
                                                        </userDefinedRuntimeAttribute>
                                                    </userDefinedRuntimeAttributes>
                                                </imageView>
                                                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="6" translatesAutoresizingMaskIntoConstraints="NO" id="INFO" userLabel="Info Stack">
                                                    <rect key="frame" x="88" y="22.833333333333336" width="289" height="68.333333333333329"/>
                                                    <subviews>
                                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Title" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="TITLE" userLabel="Title Label">
                                                            <rect key="frame" x="0.0" y="0.0" width="289" height="20.333333333333332"/>
                                                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="17"/>
                                                            <color key="textColor" systemColor="labelColor"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Subtitle" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="SUBTITLE" userLabel="Subtitle Label">
                                                            <rect key="frame" x="0.0" y="26.333333333333336" width="289" height="18"/>
                                                            <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                                            <color key="textColor" systemColor="secondaryLabelColor"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <stackView opaque="NO" contentMode="scaleToFill" spacing="2" translatesAutoresizingMaskIntoConstraints="NO" id="RATING" userLabel="Rating Stack">
                                                            <rect key="frame" x="0.0" y="50.333333333333336" width="289" height="18"/>
                                                            <subviews>
                                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="1" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="STAR1" userLabel="Star 1">
                                                                    <rect key="frame" x="0.0" y="0.0" width="18" height="18"/>
                                                                    <color key="tintColor" systemColor="systemYellowColor"/>
                                                                    <constraints>
                                                                        <constraint firstAttribute="width" constant="18" id="C-STAR1-W"/>
                                                                    </constraints>
                                                                </imageView>
                                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="2" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="STAR2" userLabel="Star 2">
                                                                    <rect key="frame" x="20" y="0.0" width="18" height="18"/>
                                                                    <color key="tintColor" systemColor="systemYellowColor"/>
                                                                    <constraints>
                                                                        <constraint firstAttribute="width" constant="18" id="C-STAR2-W"/>
                                                                    </constraints>
                                                                </imageView>
                                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="3" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="STAR3" userLabel="Star 3">
                                                                    <rect key="frame" x="40" y="0.0" width="18" height="18"/>
                                                                    <color key="tintColor" systemColor="systemYellowColor"/>
                                                                    <constraints>
                                                                        <constraint firstAttribute="width" constant="18" id="C-STAR3-W"/>
                                                                    </constraints>
                                                                </imageView>
                                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="4" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="STAR4" userLabel="Star 4">
                                                                    <rect key="frame" x="60" y="0.0" width="18" height="18"/>
                                                                    <color key="tintColor" systemColor="systemYellowColor"/>
                                                                    <constraints>
                                                                        <constraint firstAttribute="width" constant="18" id="C-STAR4-W"/>
                                                                    </constraints>
                                                                </imageView>
                                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="5" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="STAR5" userLabel="Star 5">
                                                                    <rect key="frame" x="80" y="0.0" width="18" height="18"/>
                                                                    <color key="tintColor" systemColor="systemYellowColor"/>
                                                                    <constraints>
                                                                        <constraint firstAttribute="width" constant="18" id="C-STAR5-W"/>
                                                                    </constraints>
                                                                </imageView>
                                                                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="SPACER" userLabel="Spacer">
                                                                    <rect key="frame" x="100" y="0.0" width="189" height="18"/>
                                                                </view>
                                                            </subviews>
                                                            <constraints>
                                                                <constraint firstAttribute="height" constant="18" id="C-RATING-H"/>
                                                            </constraints>
                                                        </stackView>
                                                    </subviews>
                                                </stackView>
                                            </subviews>
                                            <constraints>
                                                <constraint firstItem="COVER" firstAttribute="leading" secondItem="CV" secondAttribute="leading" constant="16" id="C-COVER-L"/>
                                                <constraint firstItem="COVER" firstAttribute="centerY" secondItem="CV" secondAttribute="centerY" id="C-COVER-CY"/>
                                                <constraint firstItem="COVER" firstAttribute="top" relation="greaterThanOrEqual" secondItem="CV" secondAttribute="top" constant="12" id="C-COVER-T"/>
                                                <constraint firstItem="CV" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="COVER" secondAttribute="bottom" constant="12" id="C-COVER-B"/>
                                                <constraint firstItem="INFO" firstAttribute="leading" secondItem="COVER" secondAttribute="trailing" constant="12" id="C-INFO-L"/>
                                                <constraint firstItem="CV" firstAttribute="trailing" secondItem="INFO" secondAttribute="trailing" constant="16" id="C-INFO-R"/>
                                                <constraint firstItem="INFO" firstAttribute="centerY" secondItem="CV" secondAttribute="centerY" id="C-INFO-CY"/>
                                                <constraint firstItem="INFO" firstAttribute="top" relation="greaterThanOrEqual" secondItem="CV" secondAttribute="top" constant="12" id="C-INFO-T"/>
                                                <constraint firstItem="CV" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="INFO" secondAttribute="bottom" constant="12" id="C-INFO-B"/>
                                            </constraints>
                                        </tableViewCellContentView>
                                        <connections>
                                            <outlet property="coverImageView" destination="COVER" id="O-COVER"/>
                                            <outlet property="subtitleLabel" destination="SUBTITLE" id="O-SUBTITLE"/>
                                            <outlet property="titleLabel" destination="TITLE" id="O-TITLE"/>
                                            <outletCollection property="starImageViews" destination="STAR1" collectionClass="NSMutableArray" id="O-STAR1"/>
                                            <outletCollection property="starImageViews" destination="STAR2" collectionClass="NSMutableArray" id="O-STAR2"/>
                                            <outletCollection property="starImageViews" destination="STAR3" collectionClass="NSMutableArray" id="O-STAR3"/>
                                            <outletCollection property="starImageViews" destination="STAR4" collectionClass="NSMutableArray" id="O-STAR4"/>
                                            <outletCollection property="starImageViews" destination="STAR5" collectionClass="NSMutableArray" id="O-STAR5"/>
                                        </connections>
                                    </tableViewCell>
                                </prototypes>
                                <connections>
                                    <outlet property="dataSource" destination="VC" id="O-DATASOURCE"/>
                                </connections>
                            </tableView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="SAFE"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="TBL" firstAttribute="top" secondItem="SAFE" secondAttribute="top" id="C-TBL-T"/>
                            <constraint firstItem="TBL" firstAttribute="leading" secondItem="SAFE" secondAttribute="leading" id="C-TBL-L"/>
                            <constraint firstItem="SAFE" firstAttribute="trailing" secondItem="TBL" secondAttribute="trailing" id="C-TBL-R"/>
                            <constraint firstItem="SAFE" firstAttribute="bottom" secondItem="TBL" secondAttribute="bottom" id="C-TBL-B"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Favorite Games" id="NAV-ITEM"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="VC-FR" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="rdr2" width="600" height="900"/>
        <systemColor name="labelColor">
            <color white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
        <systemColor name="secondaryLabelColor">
            <color red="0.23529411764705882" green="0.23529411764705882" blue="0.2627450980392157" alpha="0.59999999999999998" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
        <systemColor name="systemYellowColor">
            <color red="1" green="0.80000000000000004" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
    </resources>
</document>
