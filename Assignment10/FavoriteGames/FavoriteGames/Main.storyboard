                                            </imageView>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="5" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="star.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="DS5" userLabel="Star 5">
                                                <rect key="frame" x="112" y="0.0" width="24" height="24"/>
                                                <color key="tintColor" systemColor="systemYellowColor"/>
                                                <constraints>
