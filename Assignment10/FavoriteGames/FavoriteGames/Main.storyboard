                                            <constraint firstItem="DCOVER" firstAttribute="centerX" secondItem="DCONTENT" secondAttribute="centerX" id="DC-02"/>
                                            <constraint firstItem="DTITLE" firstAttribute="top" secondItem="DCOVER" secondAttribute="bottom" constant="16" id="DC-03"/>
                                            <constraint firstItem="DTITLE" firstAttribute="leading" secondItem="DCONTENT" secondAttribute="leading" constant="16" id="DC-04"/>
